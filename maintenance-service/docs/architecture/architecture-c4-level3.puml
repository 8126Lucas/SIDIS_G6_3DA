@startuml
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 55
skinparam shadowing false
skinparam componentStyle uml2

title Component Diagram (C4 - Level 3) - Maintenance Service (As Implemented, CQRS)

component "API Gateway\n<<Spring Cloud Gateway>>" as api_gateway
database "PostgreSQL\nmaintenance_db\n<<Write model>>" as maintenance_pg
database "Redis Cluster\nMaintenanceRecord, MaintenanceTemplate\n<<Read model>>" as maintenance_redis
queue "RabbitMQ\nmaintenance.exchange\nmaintenancetemplate.exchange" as rabbit
component "Aircraft Service\n<<Microservice>>" as aircraft_service

package "Maintenance Service [Container]" {
    component "MaintenanceSecurityConfig\n<<SecurityFilterChain + gatewaySecretFilter>>" as security_filter

    component "MaintenanceRecordController\n<<Spring REST Controller>>" as controller
    component "LandingController\n<<Spring REST Controller>>" as landing_controller

    package "Command side" {
        component "AddMaintenanceTemplateUseCase\n<<UseCase>>" as add_template_uc
        component "AddMaintenanceRecordUseCase\n<<UseCase>>" as add_record_uc
        component "MaintenanceRecordProgressService\n<<UseCase>>" as progress_svc
        component "MaintenanceTemplateCommandRepository\n<<Spring Data JPA>>" as template_cmd_repo
        component "MaintenanceRecordCommandRepository\n<<Spring Data JPA>>" as record_cmd_repo
    }

    package "Query side" {
        component "MaintenanceTemplateSearchService\n<<Spring Service>>" as template_search_svc
        component "MaintenanceRecordSearchService\n<<Spring Service>>" as record_search_svc
        component "MaintenanceReportService\n<<UseCase>>" as report_svc
        component "MaintenanceAlertService\n<<UseCase>>" as alert_svc
        component "PartsInventoryService\n<<UseCase>>" as parts_svc
        component "MaintenanceTemplateQueryRepository\n<<Spring Data Redis>>" as template_query_repo
        component "MaintenanceRecordQueryRepository\n<<Spring Data Redis>>" as record_query_repo
    }

    package "Synchronisation" {
        component "RabbitMQConfig\n<<topic exchanges, durable queues,\nJSON converter>>" as rabbit_config
        component "MaintenanceTemplateRedisProjector\n<<@RabbitListener>>" as template_projector
        component "MaintenanceRecordRedisProjector\n<<@RabbitListener>>" as record_projector
    }

    component "AircraftRestClientService\n<<RestClient Adapter>>\n@Retryable x3" as aircraft_client
    component "PeerForwarder\n<<DiscoveryClient + RestClient>>" as peer_forwarder
    component "JwtTokenInterceptor\n<<ClientHttpRequestInterceptor>>\n(shared builder, 2 s timeouts)" as jwt_interceptor

    component "Bootstrap\n<<ApplicationRunner>>" as bootstrapper
    component "GlobalExceptionHandler\n<<@RestControllerAdvice>>" as exception_handler
}

api_gateway --> security_filter : "Routes /api/maintenance/~**\n(JWT validated, X-Gateway-Secret added)\n[HTTP/JSON]"
security_filter --> controller : "secret OK"
security_filter --> landing_controller : "secret OK"

' --- commands ---
controller --> add_template_uc : "POST /templates"
controller --> aircraft_client : "aircraft check"
controller --> add_record_uc : "POST /record"
controller --> progress_svc : "PATCH /records/{id},\n/status, /complete"
add_template_uc --> template_cmd_repo : "save"
add_record_uc --> template_cmd_repo : "findById"
add_record_uc --> record_cmd_repo : "save"
progress_svc --> record_cmd_repo : "findByRecordId / save"
add_template_uc --> rabbit : "maintenancetemplate.event.created"
add_record_uc --> rabbit : "maintenance.event.created"
progress_svc --> rabbit : "maintenance.event.updated"

' --- projections ---
rabbit --> template_projector : "maintenancetemplate.sync.queue"
rabbit --> record_projector : "maintenance.sync.queue"
template_projector --> template_query_repo : "save MaintenanceTemplateRedis"
record_projector --> record_query_repo : "save MaintenanceRecordRedis"
rabbit_config ..> rabbit : "declares"

' --- queries ---
controller --> template_search_svc : "GET /templates, template\nof every record response"
controller --> peer_forwarder : "template not found\n(service id: aircraft-service)"
controller --> record_search_svc : "GET /records"
controller --> report_svc : "ongoing, costs, turnaround"
controller --> alert_svc : "alerts"
controller --> parts_svc : "parts inventory, low stock"
template_search_svc --> template_query_repo : "findByTemplateId / findAll"
record_search_svc --> record_query_repo : "findAll(Specification, Pageable)"
report_svc --> record_query_repo : "findByStatus / findAll"
alert_svc --> record_query_repo : "findByStatus(COMPLETED)"
parts_svc --> record_query_repo : "findAll"
report_svc --> aircraft_client : "model name"
alert_svc --> aircraft_client : "all aircraft"

' --- stores ---
template_cmd_repo --> maintenance_pg : "maintenance_template\n[JDBC/JPA]"
record_cmd_repo --> maintenance_pg : "company_maintenance_records\n[JDBC/JPA]"
template_query_repo --> maintenance_redis : "MaintenanceTemplate:<id>"
record_query_repo --> maintenance_redis : "MaintenanceRecord:<id>"
bootstrapper --> template_cmd_repo : "seeds templates\n(PostgreSQL only)"
bootstrapper --> record_cmd_repo : "seeds records\n(PostgreSQL only)"

' --- outgoing HTTP ---
aircraft_client --> jwt_interceptor : "outgoing request"
peer_forwarder --> jwt_interceptor : "GET /api/maintenance/templates/{id}"
jwt_interceptor --> aircraft_service : "HTTP RestClient\n(X-Gateway-Secret, Authorization)"
jwt_interceptor -[hidden]down- maintenance_pg
jwt_interceptor -[hidden]down- maintenance_redis
jwt_interceptor -[hidden]down- rabbit

@enduml
