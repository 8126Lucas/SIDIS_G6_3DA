@startuml
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false

title Sequence Diagram - Scenario 3: Inter-Service Route Analytics (As Implemented)

autonumber

actor "Client / Postman" as client
participant "API Gateway\n<<Gateway>>" as gateway
participant "AirportController\n<<REST Controller>>" as controller
participant "AirportService\n<<UseCase>>" as airport_uc
participant "RouteRestClientService\n<<RestClient Adapter>>" as route_client
participant "AirportRepository\n<<JPA Repository>>" as repo
participant "GlobalExceptionHandler\n<<ControllerAdvice>>" as exception_handler
participant "Route Service\n<<External Microservice>>" as route_api

box "Airport Service [Container]" #LightBlue
    participant controller
    participant airport_uc
    participant route_client
    participant repo
    participant exception_handler
end box

== Flow A: Airport Routes ==

client -> gateway : GET /api/airports/{iataCode}/routes
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> airport_uc : findRoutesByAirport(iataCode)
activate airport_uc
airport_uc -> repo : findByIataCode(iataCode)
activate repo
repo --> airport_uc : Optional<Airport>
deactivate repo

alt airport not found
    airport_uc -[#red]> exception_handler : throw DomainException("Airport does not exist")
    activate exception_handler
    exception_handler --> client : 409 Conflict (ErrorDetails JSON)
    deactivate exception_handler
else airport found
    airport_uc -> route_client : getRoutes()
    activate route_client
    route_client -> route_api : GET /api/routes\n(+ X-Gateway-Secret, Authorization via JwtTokenInterceptor)
    activate route_api
    route_api --> route_client : RouteClientDTO[] (all routes)
    deactivate route_api
    route_client -> route_client : map to RouteResponse
    route_client --> airport_uc : List<RouteResponse>
    deactivate route_client
    airport_uc -> airport_uc : keep routes with origin or destination == iataCode
    airport_uc --> controller : List<RouteResponse>
    deactivate airport_uc
    controller --> gateway : 200 OK (JSON list)
    gateway --> client : 200 OK Response
end
deactivate controller
deactivate gateway

== Flow B: Busiest Airports ==

client -> gateway : GET /api/airports/busiest
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> airport_uc : busiestAirports()
activate airport_uc

airport_uc -> route_client : getRoutes()
activate route_client
route_client -> route_api : GET /api/routes
activate route_api
route_api --> route_client : RouteClientDTO[]
deactivate route_api
route_client --> airport_uc : List<RouteResponse>
deactivate route_client

loop for each route
    airport_uc -> repo : findByIataCode(originAirportIata)
    repo --> airport_uc : Optional<Airport>
    airport_uc -> repo : findByIataCode(destinationAirportIata)
    repo --> airport_uc : Optional<Airport>
    airport_uc -> airport_uc : counts.merge(airport, 1)
end

airport_uc -> airport_uc : sort by numberOfRoutes desc
airport_uc --> controller : List<AirportRouteStatistic>
deactivate airport_uc
controller --> gateway : 200 OK (iataCode, name, numberOfRoutes)
deactivate controller
gateway --> client : 200 OK Response
deactivate gateway

note over route_client, route_api : 2 s timeouts; @Retryable is present but inactive (no @EnableRetry);\nany route-service error propagates as 500 (ErrorDetails)

@enduml
