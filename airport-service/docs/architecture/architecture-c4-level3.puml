@startuml
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam shadowing false
skinparam componentStyle uml2

title Component Diagram (C4 - Level 3) - Airport Service (As Implemented, CQRS)

component "API Gateway\n<<Spring Cloud Gateway>>" as api_gateway
database "PostgreSQL\nairport_db\n<<Write model>>" as airport_pg
database "Redis Cluster\nAirport:<iataCode>\n<<Read model>>" as airport_redis
queue "RabbitMQ\nairport.exchange" as rabbit
component "Route Service\n<<Microservice>>" as route_service
component "Flight Service\n<<Microservice>>" as flight_service

package "Airport Service [Container]" {
    component "AirportSecurityConfig\n<<SecurityFilterChain + gatewaySecretFilter>>" as security_filter
    component "AirportController\n<<Spring REST Controller>>" as airport_controller

    package "Command side" {
        component "AirportService\n<<UseCase>>" as airport_uc
        component "AirportCsvService\n<<Spring Service>>" as csv_svc
        component "AirportRepository\n<<Spring Data JPA>>" as airport_repo
    }

    package "Query side" {
        component "AirportQueryService\n<<Spring Service>>" as query_svc
        component "AirportReadRepository\n<<Spring Data Redis>>" as read_repo
    }

    package "Synchronisation" {
        component "AirportReadModelMapper" as mapper
        component "AirportEventPublisher\n<<@TransactionalEventListener\nAFTER_COMMIT>>" as publisher
        component "AirportRedisProjector\n<<@RabbitListener>>\n(version check)" as projector
    }

    component "RouteRestClientService\n<<RestClient Adapter>>\n@Retryable (inactive)" as route_client
    component "JwtTokenInterceptor\n<<ClientHttpRequestInterceptor>>" as jwt_interceptor
    component "Bootstrap\n<<ApplicationRunner>>" as bootstrapper
}

api_gateway --> security_filter : "Routes /api/airports/~**\n(JWT validated, X-Gateway-Secret added)"
flight_service --> security_filter : "GET /api/airports/{iataCode}"
route_service --> security_filter : "GET /api/airports/{iataCode}"
security_filter --> airport_controller : "secret OK"

' --- commands ---
airport_controller --> airport_uc : "register, updates,\ncertifications"
airport_controller --> csv_svc : "POST /import (parse)"
airport_controller ..> airport_uc : "execute(airport) per CSV row"
airport_uc --> airport_repo : "save"
airport_uc --> mapper : "AirportChangedEvent\n(Spring event)"
mapper ..> publisher
publisher --> rabbit : "airport.event.updated\n(after commit)"
rabbit --> projector : "airport.sync.queue"
projector --> read_repo : "save if newer version"

' --- queries ---
airport_controller --> query_svc : "by IATA, search, grouped,\nbusiest, routes per airport"
query_svc --> read_repo : "findById / indexed fields"
query_svc --> route_client : "all routes"

' --- stores ---
airport_repo --> airport_pg : "company_registered_airports\n[JDBC/JPA]"
read_repo --> airport_redis
bootstrapper --> airport_repo : "seeds if empty"
bootstrapper --> publisher : "republishes every\nairport on start"

route_client --> jwt_interceptor : "outgoing request"
jwt_interceptor --> route_service : "HTTP RestClient\n(X-Gateway-Secret, Authorization)"

@enduml
