@GATEWAY=https://localhost:7979
### LOGIN
POST {{GATEWAY}}/api/auth/login
Content-Type: application/json

{
  "username": "backoffice",
  "password": "backoffice123"
}

> {%
    client.global.set("token", response.body.token);
%}

### US207 - REGISTER ENHANCED AIRPORT with OPERATIONAL HOURS (us207)
POST {{GATEWAY}}/api/airports
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "iataCode": "RYS",
  "airportType": "International",
  "name": "Humberto Delgado Airport",
  "status": "OPERATIONAL",
  "operationalHours": "06:00-23:00",
  "location": {
    "city": "Lisbon",
    "longitude": -9.1359,
    "latitude": 38.7742,
    "region": "Lisbon",
    "timezone": "Europe/Lisbon",
    "country": "Portugal"
  },
  "facilities": {
    "terminalCount": 2,
    "services": ["fuel", "maintenance"],
    "gateCount": 48
  },
  "routeDistance": 0.0,
  "runways": [
    {
      "runwayName": "03/21",
      "length": 3805.0,
      "orientation": "NE/SW",
      "status": "OPEN"
    }
  ],
  "certifications": [],
  "contacts": [
    {
      "type": "EMAIL",
      "value": "ops@lis.pt"
    }
  ],
  "airportPhotos": ["https://example.com/lis-front.jpg"]
}

### US208 - UPDATE AIRPORT DETAILS
PATCH http://localhost:8081/api/airports/LIS/details
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Lisbon Airport",
  "operationalHours": "05:00-00:00",
  "contacts": [
    {
      "type": "PHONE",
      "value": "+351210000000"
    }
  ]
}

