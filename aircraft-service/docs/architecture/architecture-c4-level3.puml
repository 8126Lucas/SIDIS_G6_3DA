@startuml
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 55
skinparam shadowing false
skinparam componentStyle uml2

title Component Diagram (C4 - Level 3) - Aircraft Service (As Implemented, CQRS)

component "API Gateway\n<<Spring Cloud Gateway>>" as api_gateway
database "PostgreSQL\naircraft_db\n<<Write model>>" as aircraft_pg
database "Redis Cluster\nAircraft, AircraftModel\n<<Read model>>" as aircraft_redis
queue "RabbitMQ\naircraft.exchange\naircraftmodel.exchange" as rabbit
component "Route Service\n<<Microservice>>" as route_service
component "Flight Service\n<<Microservice>>" as flight_service

package "Aircraft Service [Container]" {
    component "AircraftSecurityConfig\n<<SecurityFilterChain + gatewaySecretFilter>>" as security_filter

    component "ModelCatalogController\n<<Spring REST Controller>>" as catalog_controller
    component "HangarController\n<<Spring REST Controller>>" as hangar_controller
    component "HangarViewController\n<<Spring MVC Controller>>" as view_controller

    package "Command side" {
        component "AddModelUseCase\n<<UseCase>>" as add_model_uc
        component "AircraftModelUpdater\n<<Spring Service>>" as model_updater
        component "AddAircraftUseCase\n<<UseCase>>" as add_aircraft_uc
        component "AircraftLifeCycleUpdaterService\n<<Spring Service>>" as lifecycle_svc
        component "AircraftModelCommandRepository\n<<Spring Data JPA>>" as model_cmd_repo
        component "AircraftCommandRepository\n<<Spring Data JPA>>" as aircraft_cmd_repo
    }

    package "Query side" {
        component "AircraftModelSearchService\n<<Spring Service>>" as model_search_svc
        component "AircraftSearchService\n<<Spring Service>>" as aircraft_search_svc
        component "FlightSearchService\n<<Spring Service>>" as flight_search_svc
        component "FuelEfficiencyService\n<<UseCase>>" as fuel_uc
        component "RouteSearchService\n<<Spring Service>>" as route_search_svc
        component "CalculationsService\n<<Spring Service>>" as calc_svc
        component "AircraftModelQueryRepository\n<<Spring Data Redis>>" as model_query_repo
        component "AircraftQueryRepository\n<<Spring Data Redis>>" as aircraft_query_repo
    }

    package "Synchronisation" {
        component "RabbitMQConfig\n<<topic exchanges, durable queues,\nJSON converter>>" as rabbit_config
        component "AircraftModelRedisProjector\n<<@RabbitListener>>" as model_projector
        component "AircraftRedisProjector\n<<@RabbitListener>>" as aircraft_projector
    }

    component "RouteRestClientService\n<<RestClient Adapter>>\n@Retryable x3" as route_client
    component "FlightRestClientService\n<<RestClient Adapter>>\n@Retryable x3" as flight_client
    component "PeerForwarder\n<<DiscoveryClient + RestClient>>" as peer_forwarder
    component "JwtTokenInterceptor\n<<ClientHttpRequestInterceptor>>\n(shared builder, 2 s timeouts)" as jwt_interceptor

    component "Bootstrap\n<<ApplicationRunner>>" as bootstrapper

    component "GlobalExceptionHandler\n<<@RestControllerAdvice>>" as exception_handler
}

api_gateway --> security_filter : "Routes /api/hangar/~**, /api/catalog/~**\n(JWT validated, X-Gateway-Secret added)\n[HTTP/JSON]"
security_filter --> hangar_controller : "secret OK"
security_filter --> catalog_controller : "secret OK"
security_filter --> view_controller : "secret OK"

' --- commands ---
catalog_controller --> add_model_uc : "POST /model"
catalog_controller --> model_updater : "PATCH /model/{modelName}"
hangar_controller --> lifecycle_svc : "availability change"
hangar_controller --> add_aircraft_uc : "POST /aircraft"

add_model_uc --> model_cmd_repo : "save"
model_updater --> model_cmd_repo : "findByModelName / save"
add_aircraft_uc --> model_cmd_repo : "findByModelName"
add_aircraft_uc --> aircraft_cmd_repo : "save"
lifecycle_svc --> aircraft_cmd_repo : "findById / save"

add_model_uc --> rabbit : "aircraftmodel.event.created"
model_updater --> rabbit : "aircraftmodel.event.updated"
add_aircraft_uc --> rabbit : "aircraft.event.created"
lifecycle_svc --> rabbit : "aircraft.event.updated"

' --- projections ---
rabbit --> model_projector : "aircraftmodel.sync.queue"
rabbit --> aircraft_projector : "aircraft.sync.queue"
model_projector --> model_query_repo : "save AircraftModelRedis"
aircraft_projector --> aircraft_query_repo : "save AircraftRedis"
rabbit_config ..> rabbit : "declares"

' --- queries ---
catalog_controller --> model_search_svc : "GET /{modelName}"
catalog_controller --> flight_search_svc : "rankings (assignments)"
catalog_controller --> aircraft_search_svc : "rankings (flight-hours)"
hangar_controller --> aircraft_search_svc : "queries + analytics"
hangar_controller --> route_search_svc : "compatible routes"
hangar_controller --> fuel_uc : "US227 fuel metrics"
hangar_controller --> peer_forwarder : "aircraft not in Redis"
view_controller --> calc_svc : "utilization data"
calc_svc --> aircraft_search_svc : "findAll"

model_search_svc --> model_query_repo : "findByModelName"
aircraft_search_svc --> aircraft_query_repo : "findById / findAll / countByStatus"
flight_search_svc --> aircraft_query_repo : "findById"
fuel_uc --> aircraft_query_repo : "findAll / findById"

' --- stores ---
model_cmd_repo --> aircraft_pg : "aircraft_models_catalog\n[JDBC/JPA]"
aircraft_cmd_repo --> aircraft_pg : "company_aircrafts\n[JDBC/JPA]"
model_query_repo --> aircraft_redis : "AircraftModel:<modelName>"
aircraft_query_repo --> aircraft_redis : "Aircraft:<registration>"
bootstrapper --> model_cmd_repo : "seeds catalog\n(PostgreSQL only)"
bootstrapper --> aircraft_cmd_repo : "seeds fleet\n(PostgreSQL only)"

' --- outgoing HTTP ---
flight_search_svc --> flight_client : "all flights"
fuel_uc --> flight_client : "all flights"
fuel_uc --> route_client : "route by id"
calc_svc --> flight_client : "flights by aircraft"
hangar_controller --> route_client : "GET all routes"
hangar_controller --> flight_client : "legacy fuel efficiency"
route_client --> jwt_interceptor : "outgoing request"
flight_client --> jwt_interceptor : "outgoing request"
peer_forwarder --> jwt_interceptor : "GET /api/hangar/aircraft/{reg}\non other instances"
jwt_interceptor --> route_service : "HTTP RestClient\n(X-Gateway-Secret, Authorization)"
jwt_interceptor --> flight_service : "HTTP RestClient\n(X-Gateway-Secret, Authorization)"
jwt_interceptor -[hidden]down- aircraft_pg
jwt_interceptor -[hidden]down- aircraft_redis
jwt_interceptor -[hidden]down- rabbit

@enduml
