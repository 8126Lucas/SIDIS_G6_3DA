@startuml
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false

title Sequence Diagram - Scenario 2: Register Aircraft and Change Availability (As Implemented, CQRS)

autonumber

actor "Client / Postman" as client
participant "HAProxy + API Gateway" as gateway
participant "HangarController\n<<REST Controller>>" as controller
participant "AircraftLifeCycleUpdaterService\n<<Application Service>>" as lifecycle
participant "AddAircraftUseCase\n<<UseCase>>" as add_uc
participant "AircraftModelCommandRepository\nAircraftCommandRepository\n<<JPA>>" as cmd_repo
database "PostgreSQL\naircraft_db" as pg
queue "RabbitMQ\naircraft.exchange" as mq
participant "AircraftRedisProjector\n<<@RabbitListener>>\n(any instance)" as projector
database "Redis cluster" as redis
participant "GlobalExceptionHandler\n<<ControllerAdvice>>" as exception_handler

box "Aircraft Service [Container]" #LightBlue
    participant controller
    participant lifecycle
    participant add_uc
    participant cmd_repo
    participant projector
    participant exception_handler
end box

== Register Aircraft (US102) ==

client -> gateway : POST /api/hangar/aircraft\n(registrationNumber, modelName, manufacturingDate, hours, availability)
activate gateway
gateway -> controller : Forward request\n(JWT validated, + X-Gateway-Secret, X-User-Name)
activate controller

controller -> lifecycle : changeAvailability(registrationNumber, availability)
activate lifecycle
lifecycle -> cmd_repo : findById(registrationNumber)
cmd_repo -> pg : SELECT ... FROM company_aircrafts
pg --> cmd_repo : no row (aircraft not created yet)
cmd_repo --> lifecycle : Optional.empty
lifecycle -[#red]> exception_handler : throw ResourceNotFoundException\n("Aircraft not found in database")
deactivate lifecycle
activate exception_handler
exception_handler --> client : 404 Not Found (ErrorDetails JSON)
deactivate exception_handler
deactivate controller
deactivate gateway

note over controller, add_uc
  As implemented, the availability is changed before the aircraft exists,
  so every new registration ends here. The steps below are the
  creation that AddAircraftUseCase would run next.
end note

controller -> add_uc : execute(registrationNumber, modelName, ...)
activate add_uc
add_uc -> cmd_repo : findByModelName(modelName)
cmd_repo -> pg : SELECT ... FROM aircraft_models_catalog
alt model missing
    add_uc -[#red]> exception_handler : throw DomainException\n("Aircraft Model does not exist!")
    exception_handler --> client : 409 Conflict
else model found
    add_uc -> cmd_repo : save(new Aircraft)
    cmd_repo -> pg : INSERT INTO company_aircrafts (+ features, components, certifications)
    add_uc -> mq : AircraftSyncEvent\nkey aircraft.event.created
    add_uc --> controller : void
    controller --> client : 201 Created
end
deactivate add_uc

== Projection (asynchronous) ==

mq -> projector : aircraft.sync.queue\n(one consumer per event)
activate projector
projector -> redis : save AircraftRedis\nAircraft:<registration>
deactivate projector

== Change Availability (US105) ==

client -> gateway : PATCH /api/hangar/aircraft/{registrationNumber}\n(registrationNumber, availability)
activate gateway
gateway -> controller : Forward request
activate controller

alt path and body registration differ
    controller -[#red]> exception_handler : throw DomainException("Non matching info")
    exception_handler --> client : 409 Conflict
else registrations match
    controller -> lifecycle : changeAvailability(registrationNumber, availability)
    activate lifecycle
    lifecycle -> cmd_repo : findById(registrationNumber)
    cmd_repo -> pg : SELECT ... FROM company_aircrafts
    alt aircraft missing
        lifecycle -[#red]> exception_handler : throw ResourceNotFoundException
        exception_handler --> client : 404 Not Found
    else found
        lifecycle -> lifecycle : activate / sendToMaintenance / retire / sendAircraftInFlight
        lifecycle -> cmd_repo : save(aircraft)
        cmd_repo -> pg : UPDATE company_aircrafts SET status = ?, version = version + 1
        lifecycle -> mq : AircraftSyncEvent\nkey aircraft.event.updated
        lifecycle --> controller : void
        controller --> client : 200 OK
    end
    deactivate lifecycle
end
deactivate controller
deactivate gateway

mq -> projector : aircraft.sync.queue
projector -> redis : replace Aircraft:<registration>

@enduml
