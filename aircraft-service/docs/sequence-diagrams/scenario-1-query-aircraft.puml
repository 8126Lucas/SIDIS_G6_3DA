@startuml
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false

title Sequence Diagram - Scenario 1: Read and Analytics Flows (As Implemented)

autonumber

actor "Client / Postman" as client
participant "API Gateway\n<<Gateway>>" as gateway
participant "gatewaySecretFilter\n<<OncePerRequestFilter>>" as secret_filter
participant "HangarController\n<<REST Controller>>" as controller
participant "AircraftSearchService\n<<Application Service>>" as search_svc
participant "AircraftQueryRepository\n<<Spring Data Redis>>" as repo
database "Redis cluster\n<<Read model>>" as db
participant "GlobalExceptionHandler\n<<ControllerAdvice>>" as exception_handler

box "Aircraft Service [Container]" #LightBlue
    participant secret_filter
    participant controller
    participant search_svc
    participant repo
    participant exception_handler
end box

== Flow A: Aircraft by Registration (US103) ==

client -> gateway : GET /api/hangar/aircraft/{registrationNumber}
activate gateway
gateway -> gateway : validate JWT (JwtAuthentication)
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> search_svc : spotAircraftInHangar(registrationNumber)
activate search_svc
search_svc -> repo : findById(registrationNumber)
activate repo
repo -> db : HGETALL Aircraft:<registrationNumber>
activate db
db --> repo : hash fields
deactivate db
repo --> search_svc : Optional<AircraftRedis>
deactivate repo
search_svc --> controller : Optional<AircraftRedis>
deactivate search_svc

alt Aircraft found
    controller --> gateway : 200 OK (AircraftResponse JSON)
    gateway --> client : 200 OK Response
else Aircraft not found
    controller -[#red]> exception_handler : throw ResourceNotFoundException
    activate exception_handler
    exception_handler --> client : 404 Not Found (ErrorDetails JSON)
    deactivate exception_handler
end
deactivate controller
deactivate gateway

== Flow B: Filtered Search (US104) ==

client -> gateway : GET /api/hangar/aircraft?model=&status=&manufacturingDate=&page=&size=
activate gateway
gateway -> gateway : validate JWT (JwtAuthentication)
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> search_svc : findAircraftsMatchingFilter(model, status, date, pageable)
activate search_svc
search_svc -> repo : findAll()
activate repo
repo -> db : SMEMBERS Aircraft + HGETALL per key
activate db
db --> repo : all aircraft hashes
deactivate db
repo --> search_svc : List<AircraftRedis>
deactivate repo
search_svc -> search_svc : filter in memory (model, status, date)\nand cut the requested page
search_svc --> controller : Page<AircraftRedis>
deactivate search_svc

controller --> gateway : 200 OK (List<AircraftResponse>)
deactivate controller
gateway --> client : 200 OK Response
deactivate gateway

== Flow C: Status Summary (US205) ==

client -> gateway : GET /api/hangar/analytics/status-summary
activate gateway
gateway -> gateway : validate JWT (JwtAuthentication)
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

loop for each AircraftAvailability
    controller -> search_svc : countByAvailability(status)
    activate search_svc
    search_svc -> repo : countByStatus(status)
    activate repo
    repo -> db : derived query on status\n(no @Indexed: no secondary index exists)
    db --> repo : nothing found
    repo --> search_svc : no value (request ends in 500)
    deactivate repo
    search_svc --> controller : long
    deactivate search_svc
end

controller --> gateway : 200 OK (Map<AircraftAvailability, Long>)
deactivate controller
gateway --> client : 200 OK Response
deactivate gateway

== Flow D: Rejected Requests (Gateway JWT / Secret Filter) ==

client -> gateway : GET /api/hangar/aircraft/{registrationNumber}\n(no or invalid Authorization header)
activate gateway
gateway -> gateway : JWT missing / invalid
gateway --[#red]> client : 401 Unauthorized (empty body)
deactivate gateway

client -> secret_filter : GET http://localhost:8081/api/hangar/aircraft/{registrationNumber}\n(direct call, no X-Gateway-Secret)
activate secret_filter
secret_filter -> secret_filter : path is not /actuator, /h2-console, /swagger-ui, /api-docs
secret_filter --[#red]> client : 403 Forbidden\n"Unauthorized Access! Please use the API Gateway!"
deactivate secret_filter

note over gateway, controller : In Flows A-C the forwarded request carries X-Gateway-Secret,\nso gatewaySecretFilter passes it to the controller (omitted above for brevity).

@enduml
