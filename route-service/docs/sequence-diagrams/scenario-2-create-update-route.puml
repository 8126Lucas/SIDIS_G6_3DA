@startuml
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false

title Sequence Diagram - Scenario 2: Create and Update Route (As Implemented)

autonumber

actor "Client / Postman" as client
participant "API Gateway\n<<Gateway>>" as gateway
participant "RouteController\n<<REST Controller>>" as controller
participant "RouteService\n<<UseCase>>" as route_uc
participant "AirportRestClientService\n<<RestClient Adapter>>" as airport_client
participant "RouteRepository\n<<JPA Repository>>" as repo
database "H2 Database\n<<In-Memory DB>>" as db
participant "GlobalExceptionHandler\n<<ControllerAdvice>>" as exception_handler
participant "Airport Service\n<<External Microservice>>" as airport_api

box "Route Service [Container]" #LightBlue
    participant controller
    participant route_uc
    participant airport_client
    participant repo
    participant exception_handler
end box

== Flow A: Create Route ==

client -> gateway : POST /api/routes\n(routeName, originIataCode, destinationIataCode,\nestimatedFlightTimeHours, type, requirements)
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

alt requirements missing
    controller -[#red]> exception_handler : throw DomainException("Route requirements are required")
    activate exception_handler
    exception_handler --> client : 409 Conflict (ErrorDetails JSON)
    deactivate exception_handler
else requirements present
    controller -> route_uc : createRoute(...)
    activate route_uc
    route_uc -> route_uc : validate IATA codes, origin != destination,\nflight time > 0
    route_uc -> repo : findByRouteName(routeName)
    activate repo
    repo --> route_uc : Optional<Route>
    deactivate repo

    alt validation fails or name exists
        route_uc -[#red]> exception_handler : throw DomainException
        activate exception_handler
        exception_handler --> client : 409 Conflict (ErrorDetails JSON)
        deactivate exception_handler
    else valid
        loop origin and destination
            route_uc -> airport_client : findAirportByIataCode(iata)
            activate airport_client
            airport_client -> airport_api : GET /api/airports/{iataCode}\n(+ X-Gateway-Secret, Authorization via JwtTokenInterceptor)
            activate airport_api
            airport_api --> airport_client : AirportResponse (status, location, ...)\nor 409 if missing
            deactivate airport_api
            airport_client --> route_uc : AirportClientDTO (location mapped to airportLocation)
            deactivate airport_client
        end

        alt airport missing (4xx from airport-service)
            airport_client -[#red]> exception_handler : throw DomainException("Airport does not exist")
            activate exception_handler
            exception_handler --> client : 409 Conflict (ErrorDetails JSON)
            deactivate exception_handler
        else airport not OPERATIONAL
            route_uc -[#red]> exception_handler : throw DomainException("Airport is not operational")
            activate exception_handler
            exception_handler --> client : 409 Conflict (ErrorDetails JSON)
            deactivate exception_handler
        else both OPERATIONAL
            route_uc -> route_uc : fromDTOtoAirportReference(dto)\n(IATA code + location)
            route_uc -> repo : save(new Route(ACTIVE, distanceKm = 1.0))
            activate repo
            repo --> route_uc : Route
            deactivate repo
            route_uc --> controller : Route
            controller --> gateway : 201 Created (RouteResponse)
            gateway --> client : 201 Created Response
        end
    end
    deactivate route_uc
end
deactivate controller
deactivate gateway

== Flow B: Update Route ==

client -> gateway : PATCH /api/routes/{routeId}\n(destinationIataCode?, estimatedFlightTimeHours?, status?, history?)
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> route_uc : updateRoute(routeId, destination, flightTime, status, history)
activate route_uc
route_uc -> repo : findByRouteId(routeId)
activate repo
repo --> route_uc : Optional<Route>
deactivate repo

alt route not found
    route_uc -[#red]> exception_handler : throw DomainException("Route does not exist")
    activate exception_handler
    exception_handler --> client : 409 Conflict (ErrorDetails JSON)
    deactivate exception_handler
else route found
    opt destinationIataCode present
        route_uc -> airport_client : findAirportByIataCode(destination)
        airport_client -> airport_api : GET /api/airports/{iataCode}
        airport_api --> airport_client : AirportResponse
        airport_client --> route_uc : AirportClientDTO
        route_uc -> route_uc : changeDestination(...)\n[missing / not operational -> 409]
    end
    opt estimatedFlightTimeHours present
        route_uc -> route_uc : updateEstimatedFlightTime(...)\n[<= 0 -> IllegalArgumentException -> 400]
    end
    opt status present
        route_uc -> route_uc : activateRoute / suspendRoute / retireRoute + endRoute(today)\n[invalid transition -> IllegalStateException -> 409]
    end
    opt history present (sent by flight-service on scheduling)
        route_uc -> route_uc : updateRouteHistory(history)\n(replaces routeBegin, routeFinish, routeUsage)
    end
    route_uc -> repo : save(route)
    activate repo
    repo -> db : UPDATE company_routes SET ..., version = version + 1
    repo --> route_uc : Route
    deactivate repo
    route_uc --> controller : Route
    deactivate route_uc
    controller --> gateway : 200 OK (RouteResponse)
    gateway --> client : 200 OK Response
end
deactivate controller
deactivate gateway

@enduml
