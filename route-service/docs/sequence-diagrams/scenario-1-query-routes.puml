@startuml
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false

title Sequence Diagram - Scenario 1: Read Flows (As Implemented)

autonumber

actor "Client / Postman" as client
participant "API Gateway\n<<Gateway>>" as gateway
participant "RouteController\n<<REST Controller>>" as controller
participant "RouteService\n<<UseCase>>" as route_uc
participant "RouteRepository\n<<JPA Repository>>" as repo
database "H2 Database\n<<In-Memory DB>>" as db
participant "GlobalExceptionHandler\n<<ControllerAdvice>>" as exception_handler

box "Route Service [Container]" #LightBlue
    participant controller
    participant route_uc
    participant repo
    participant exception_handler
end box

== Flow A: Route by Id ==

client -> gateway : GET /api/routes/{routeId}
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> route_uc : getRouteDetails(routeId)
activate route_uc
route_uc -> repo : findByRouteId(routeId)
activate repo
repo -> db : SELECT * FROM company_routes WHERE route_id = ?
activate db
db --> repo : Route row
deactivate db
repo --> route_uc : Optional<Route>
deactivate repo

alt Route found
    route_uc --> controller : Route
    deactivate route_uc
    controller --> gateway : 200 OK (RouteResponse JSON)
    gateway --> client : 200 OK Response
else Route not found
    route_uc -[#red]> exception_handler : throw DomainException("Route does not exist")
    activate exception_handler
    exception_handler --> client : 409 Conflict (ErrorDetails JSON)
    deactivate exception_handler
end
deactivate controller
deactivate gateway

== Flow B: Filtered Search ==

client -> gateway : GET /api/routes?origin=&destination=
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> route_uc : searchRoutes(origin, destination)
activate route_uc

alt filter is not [A-Z]{3}
    route_uc -[#red]> exception_handler : throw DomainException("IATA code must have 3 uppercase letters")
    activate exception_handler
    exception_handler --> client : 409 Conflict (ErrorDetails JSON)
    deactivate exception_handler
else valid filters
    route_uc -> route_uc : Build JPA Specification (origin AND destination)
    route_uc -> repo : findAll(spec)
    activate repo
    repo -> db : SELECT ... WHERE origin_airport_iata = ? AND destination_airport_iata = ?
    activate db
    db --> repo : Route rows
    deactivate db
    repo --> route_uc : List<Route>
    deactivate repo
    route_uc --> controller : List<Route>
    deactivate route_uc
    controller --> gateway : 200 OK (List<RouteResponse>)
    gateway --> client : 200 OK Response
end
deactivate controller
deactivate gateway

== Flow C: Active Routes ==

client -> gateway : GET /api/routes/active?sortBy=popularity|distance
activate gateway
gateway -> controller : Forward request\n(+ X-Gateway-Secret, X-User-Name)
activate controller

controller -> route_uc : listActiveRoutes(sortBy)
activate route_uc
route_uc -> route_uc : Sort = distanceKm ASC\nor routeHistory.routeUsage DESC
route_uc -> repo : findByStatus(ACTIVE, sort)
activate repo
repo -> db : SELECT ... WHERE status = 'ACTIVE' ORDER BY ...
db --> repo : Route rows
repo --> route_uc : List<Route>
deactivate repo
route_uc --> controller : List<Route>
deactivate route_uc

controller --> gateway : 200 OK (List<RouteResponse>)
deactivate controller
gateway --> client : 200 OK Response
deactivate gateway

@enduml
