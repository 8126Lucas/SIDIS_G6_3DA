@startuml
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam shadowing false
skinparam componentStyle uml2

title Component Diagram (C4 - Level 3) - Route Service (As Implemented, CQRS)

component "API Gateway\n<<Spring Cloud Gateway>>" as api_gateway
database "PostgreSQL\nroute_db\n<<Write model>>" as route_pg
database "Redis Cluster\nRoute:<routeId>\n<<Read model>>" as route_redis
queue "RabbitMQ\nroute.exchange" as rabbit
component "Airport Service\n<<Microservice>>" as airport_service
component "Aircraft Service\n<<Microservice>>" as aircraft_service
component "Flight Service\n<<Microservice>>" as flight_service

package "Route Service [Container]" {
    component "RouteSecurityConfig\n<<SecurityFilterChain + gatewaySecretFilter>>" as security_filter
    component "RouteController\n<<Spring REST Controller>>" as route_controller

    package "Command side" {
        component "RouteService\n<<UseCase>>" as route_uc
        component "RouteRepository\n<<Spring Data JPA>>" as route_repo
    }

    package "Query side" {
        component "RouteQueryService\n<<Spring Service>>" as query_svc
        component "RouteExportService\n<<UseCase>>" as export_uc
        component "RouteReadRepository\n<<Spring Data Redis>>" as read_repo
    }

    package "Synchronisation" {
        component "RouteReadModelMapper" as mapper
        component "RouteEventPublisher\n<<@TransactionalEventListener\nAFTER_COMMIT>>" as publisher
        component "RouteRedisProjector\n<<@RabbitListener>>\n(version check)" as projector
    }

    component "AirportRestClientService\n<<RestClient Adapter>>" as airport_client
    component "JwtTokenInterceptor\n<<ClientHttpRequestInterceptor>>" as jwt_interceptor
    component "Bootstrap\n<<ApplicationRunner>>" as bootstrapper
}

api_gateway --> security_filter : "Routes /api/routes/~**\n(JWT validated, X-Gateway-Secret added)"
aircraft_service --> security_filter : "GET /api/routes, /{routeId}"
airport_service --> security_filter : "GET /api/routes"
flight_service --> security_filter : "GET /{routeId}, PATCH /{routeId}"
security_filter --> route_controller : "secret OK"

' --- commands ---
route_controller --> route_uc : "create, update"
route_uc --> airport_client : "airport by IATA"
route_uc --> route_repo : "save"
route_uc --> mapper : "RouteChangedEvent\n(Spring event)"
mapper ..> publisher
publisher --> rabbit : "route.event.updated\n(after commit)"
rabbit --> projector : "route.sync.queue"
projector --> read_repo : "save if newer version"

' --- queries ---
route_controller --> query_svc : "by id, history, search, active,\nper airport, alternatives, total distance"
route_controller --> export_uc : "GeoJSON / KML (US228)"
export_uc --> query_svc : "findAll"
query_svc --> read_repo : "findById / indexed fields"

' --- stores ---
route_repo --> route_pg : "company_routes\n[JDBC/JPA]"
read_repo --> route_redis
bootstrapper --> route_repo : "seeds if empty"
bootstrapper --> publisher : "republishes every\nroute on start"

airport_client --> jwt_interceptor : "outgoing request"
jwt_interceptor --> airport_service : "HTTP RestClient\n(X-Gateway-Secret, Authorization)"

note bottom of route_uc
  AircraftRestClientService and
  FlightRestClientService exist but are
  not injected anywhere.
end note

@enduml
