@startuml
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 70
skinparam shadowing false
skinparam componentStyle uml2

title Registry Topology - Discovery Service (As Implemented, 5 PCs)

node "PC1" {
    component "discovery-node1\n<<Eureka Server>>\nprofile node1 :8761" as node1
}
node "PC3" {
    component "discovery-node2\n<<Eureka Server>>\nprofile node2 :8762" as node2
}

component "API Gateway x2\n<<Eureka Client>>" as gateway
component "auth / aircraft / maintenance /\nairport / route / flight (x2 each)\n<<Eureka Clients>>\ndefaultZone: EUREKA_URL_1, EUREKA_URL_2" as clients
component "Prometheus (PC1)" as prometheus

node1 <--> node2 : "Peer replication over the LAN\nnode1 -> EUREKA_URL_2\nnode2 -> EUREKA_URL_1"

gateway --> node1 : "Register, heartbeat,\nfetch registry"
gateway ..> node2 : "Failover"

clients --> node1 : "Register by PC IP\n(EUREKA_INSTANCE_IP_ADDRESS)"
clients ..> node2 : "Failover"

prometheus ..> node1 : "Eureka service discovery\n(scrape targets)"

@enduml
