@startuml
title Logical View (Level 1) - AISafe Flight Management System

top to bottom direction
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 70
skinparam defaultTextAlignment center

' --- ENTRY ---
actor "API Client\n(Postman)" as Client
interface "HTTPS :7979" as IF_GW

component "API Gateway" as Gateway
component "Discovery Service\n(Eureka :8761 / :8762)" as Eureka

Client -( IF_GW
IF_GW - Gateway
Gateway .right.> Eureka : resolve lb://

' --- PROVIDED INTERFACES (lollipops) ---
interface "/api/auth" as IF_Auth
interface "/api/hangar\n/api/catalog" as IF_Aircraft
interface "/api/airports" as IF_Airport
interface "/api/flights" as IF_Flight
interface "/api/maintenance" as IF_Maint
interface "/api/routes" as IF_Route

' --- COMPONENTS WITH CLONES ---
package "Business Components" {
    component "Auth Service" as Auth {
        component "Instance1 :8101" as AU1 <<instance>>
        component "Instance2 :8102" as AU2 <<instance>>
    }
    component "Aircraft Service" as Aircraft {
        component "Instance1 :8081" as AC1 <<instance>>
        component "Instance2 :8082" as AC2 <<instance>>
    }
    component "Airport Service" as Airport {
        component "Instance1 :8091" as AP1 <<instance>>
        component "Instance2 :8092" as AP2 <<instance>>
    }
    component "Flight Service" as Flight {
        component "Instance1 :8111" as FL1 <<instance>>
        component "Instance2 :8112" as FL2 <<instance>>
    }
    component "Maintenance Service" as Maint {
        component "Instance1 :8121" as MT1 <<instance>>
        component "Instance2 :8122" as MT2 <<instance>>
    }
    component "Route Service" as Route {
        component "Instance1 :8131" as RT1 <<instance>>
        component "Instance2 :8132" as RT2 <<instance>>
    }
}

' --- GATEWAY -> COMPONENTS (socket -> lollipop) ---
Gateway -down-( IF_Auth
Gateway -down-( IF_Aircraft
Gateway -down-( IF_Airport
Gateway -down-( IF_Flight
Gateway -down-( IF_Maint
Gateway -down-( IF_Route

IF_Auth -down- Auth
IF_Aircraft -down- Aircraft
IF_Airport -down- Airport
IF_Flight -down- Flight
IF_Maint -down- Maint
IF_Route -down- Route

' --- INTER-COMPONENT DEPENDENCIES (HTTP/REST via Eureka) ---
Flight ..> Aircraft : GET
Flight ..> Airport : GET
Flight ..> Route : GET / PATCH
Route ..> Airport : GET
Airport ..> Route : GET
Aircraft ..> Flight : GET
Aircraft ..> Route : GET
Maint ..> Aircraft : GET

' --- INTRA-COMPONENT PEER FORWARDING ---
AC1 <.right.> AC2 : forward GET
MT1 <.right.> MT2 : forward GET*

legend bottom left
  Lollipop = REST interface provided | socket = interface required by the gateway
  Dashed arrow = HTTP/REST call between components (resolved through Eureka)
  forward GET = instance asks its clone when the resource is not in its own H2
  * maintenance forwards with service id "aircraft-service" (bug): the lookup reaches Aircraft, not the clone
  Airport, Flight, Route and Auth have no forwarding wired: data held only by the other clone returns 404
endlegend

@enduml
