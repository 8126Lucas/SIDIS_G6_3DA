@startuml
title Logical View (Level 1) - AISafe Flight Management System

left to right direction
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
skinparam linetype ortho

' --- CLIENTE EXTERNO ---
component [API Client (Postman)] as Client

package "AISafe Infrastructure Boundary" {
    interface "HTTP/HTTPS REST" as Gateway_IF
    component [API Gateway\n(Port 7979 / 8443)] as Gateway
    component [Eureka Discovery Service\n(Port 8761)] as Eureka
}

package "Core Business Microservices" {

    package "Auth & Hangar Context" {
        component [Auth Service\n(Ports 8101-8110)] as AuthService
        component [Aircraft Service\n(Ports 8081-8090)] as AircraftService
        component [Airport Service\n(Ports 8091-8100)] as AirportService
    }

    package "Operations & Maintenance Context" {
        component [Maintenance Service\n(Ports 8121-8130)] as MaintService
        component [Route Service\n(Ports 8131-8140)] as RouteService
        component [Flight Operations Service\n(Ports 8111-8120)] as FlightService
    }
}

' --- INTERFACES REST EXPOSTAS (Lollipops) ---
interface "/auth/**" as IF_Auth
interface "/api/hangar/**" as IF_Aircraft
interface "/api/airports/**" as IF_Airport
interface "/api/flights/**" as IF_Flight
interface "/api/maintenance/**" as IF_Maint
interface "/api/routes/**" as IF_Route

' --- ENTRADA E ROUTING DO GATEWAY ---
Client -- Gateway_IF
Gateway_IF - Gateway
Gateway ..> Eureka 

Gateway --> IF_Auth
Gateway --> IF_Aircraft
Gateway --> IF_Airport
Gateway --> IF_Flight
Gateway --> IF_Maint
Gateway --> IF_Route

' --- LIGAÇÕES DIRETAS DAS INTERFACES AOS SERVIÇOS ---
IF_Auth -- AuthService
IF_Aircraft -- AircraftService
IF_Airport -- AirportService
IF_Flight -- FlightService
IF_Maint -- MaintService
IF_Route -- RouteService

' --- DEPENDÊNCIAS REST INTER-SERVIÇOS (RestClient) ---

' 1. Validações do Flight Service
FlightService ..> RouteService 
FlightService ..> AircraftService 
FlightService ..> MaintService 
FlightService ..> AirportService 

' 2. Validações do Route Service
RouteService ..> AirportService 

' 3. Validações do Maintenance Service
MaintService ..> AircraftService

' 4. Validações do Aircraft Service
AircraftService ..> FlightService 
AircraftService ..> MaintService 

@enduml