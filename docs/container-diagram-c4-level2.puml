@startuml
!include <C4/C4_Container>

skinparam nodesep 90
skinparam ranksep 90
skinparam linetype polyline

title Container Diagram (C4 - Level 2) - AISafe Flight Management System (Iteration 2)

System_Ext(postman, "API Client (Postman)", "Simulates HTTP/REST requests to the system.")

System_Boundary(aisafe_boundary, "AISafe Flight Management System") {

    ' Entry point
    Container(haproxy, "HAProxy", "HAProxy 2.8 (TCP mode)", "Single entry point on PC1, port 443.\nRound robin and failover between the two gateways.")
    Container(api_gateway, "API Gateway (x2)", "Spring Cloud Gateway (WebFlux)", "Ports 7979 (PC1) and 7980 (PC4), HTTPS.\nValidates the JWT and routes through Eureka.")
    Container(discovery_service, "Discovery Service (x2)", "Spring Cloud Netflix Eureka", "Peer nodes on 8761 (PC1) and 8762 (PC3).")

    ' Security
    Container(auth_service, "Auth Service (x2)", "Spring Boot, Spring Security, JWT", "Authenticates collaborators and issues JWTs.")
    ContainerDb(auth_db, "Auth DB", "SQLite (one file per instance)", "Seeded collaborators and roles.")

    ' Services already migrated to CQRS
    Container(aircraft_service, "Aircraft Service (x2)", "Spring Boot, JPA, Spring Data Redis, AMQP", "Catalog of models and fleet (hangar).\nCQRS: writes to PostgreSQL, reads from Redis.")
    Container(maintenance_service, "Maintenance Service (x2)", "Spring Boot, JPA, Spring Data Redis, AMQP", "Templates and maintenance records.\nCQRS: writes to PostgreSQL, reads from Redis.")

    ' Services not migrated yet
    Container(airport_service, "Airport Service (x2)", "Spring Boot, JPA, OpenCSV", "Airports, runways and certifications.")
    Container(route_service, "Route Service (x2)", "Spring Boot, JPA", "Routes and their history.")
    Container(flight_service, "Flight Operations Service (x2)", "Spring Boot, JPA", "Flight scheduling and utilization reports.")
    ContainerDb(h2_dbs, "Airport / Route / Flight DBs", "H2 in memory (per instance)", "Not migrated to PostgreSQL yet.")

    ' Shared data infrastructure
    ContainerDb(postgres, "PostgreSQL", "PostgreSQL 15 (PC5)", "Write model (source of truth):\naircraft_db, maintenance_db.")
    ContainerDb(redis, "Redis Cluster", "Redis 7, 3 nodes per service", "Read model (Query side) of\naircraft and maintenance.")
    ContainerQueue(rabbitmq, "RabbitMQ", "RabbitMQ 3.12", "Topic exchanges and sync queues\nthat project writes into Redis.")

    Container(prometheus, "Prometheus", "Prometheus 2.53 (PC1)", "Scrapes /actuator/prometheus of the\ninstances found in Eureka.")
}

' Entry
Rel_D(postman, haproxy, "REST requests, Bearer JWT", "HTTPS :443")
Rel_D(haproxy, api_gateway, "Forwards the TLS connection", "TCP, round robin")

' Routing
Rel_D(api_gateway, auth_service, "/api/auth/**", "HTTP")
Rel_D(api_gateway, aircraft_service, "/api/hangar/~**, /api/catalog/~**", "HTTP + X-Gateway-Secret")
Rel_D(api_gateway, maintenance_service, "/api/maintenance/**", "HTTP + X-Gateway-Secret")
Rel_D(api_gateway, airport_service, "/api/airports/**", "HTTP + X-Gateway-Secret")
Rel_D(api_gateway, route_service, "/api/routes/**", "HTTP + X-Gateway-Secret")
Rel_D(api_gateway, flight_service, "/api/flights/**", "HTTP + X-Gateway-Secret")
Rel_L(api_gateway, discovery_service, "Registers & discovers", "Eureka")

' Data
Rel_D(auth_service, auth_db, "Reads/writes", "JDBC")
Rel_D(aircraft_service, postgres, "Commands", "JDBC")
Rel_D(maintenance_service, postgres, "Commands", "JDBC")
Rel_D(aircraft_service, rabbitmq, "Publishes / consumes sync events", "AMQP")
Rel_D(maintenance_service, rabbitmq, "Publishes / consumes sync events", "AMQP")
Rel_D(aircraft_service, redis, "Queries / projections", "Redis cluster")
Rel_D(maintenance_service, redis, "Queries / projections", "Redis cluster")
Rel_D(airport_service, h2_dbs, "Reads/writes", "JDBC")
Rel_D(route_service, h2_dbs, "Reads/writes", "JDBC")
Rel_D(flight_service, h2_dbs, "Reads/writes", "JDBC")

' Monitoring
Rel_U(prometheus, discovery_service, "Finds targets", "Eureka SD")

SHOW_LEGEND()

note as N1
  Every service registers in Eureka, and the services call each other over
  HTTP through Eureka (see global-network-and-ports.md, section 7).
  Those arrows are left out to keep the diagram readable.
end note

@enduml
