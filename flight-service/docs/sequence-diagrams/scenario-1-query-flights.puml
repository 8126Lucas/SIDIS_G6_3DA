@startuml
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false

title Sequence Diagram - Scenario 1: Read Flows (As Implemented)

autonumber

actor "Client / Postman" as client
participant "API Gateway\n<<Gateway>>" as gateway
participant "FlightController\n<<REST Controller>>" as controller
participant "RouteService\n<<UseCase>>" as route_svc
participant "FlightUtilizationReportService\n<<Application Service>>" as report_svc
participant "FlightRepository\n<<JPA Repository>>" as repo
database "H2 Database\n<<In-Memory DB>>" as db
participant "GlobalExceptionHandler\n<<ControllerAdvice>>" as exception_handler

box "Flight Operations Service [Container]" #LightBlue
    participant controller
    participant route_svc
    participant report_svc
    participant repo
    participant exception_handler
end box

== Flow A: Flights by Aircraft ==

client -> gateway : GET /api/flights/aircraft/{registrationNumber}
activate gateway

gateway -> controller : Forward GET /api/flights/aircraft/{registrationNumber}
activate controller

controller -> route_svc : getScheduledFlightsForAircraft(registrationNumber)
activate route_svc

route_svc -> repo : findByAircraftRegistrationNumber_RegistrationNumber(...)
activate repo

repo -> db : SELECT * FROM company_flights WHERE aircraft_registration = ?
activate db
db --> repo : List<Flight> entities
deactivate db

repo --> route_svc : List<Flight>
deactivate repo

route_svc --> controller : List<Flight>
deactivate route_svc

controller --> gateway : 200 OK (JSON List of Flights)
deactivate controller

gateway --> client : 200 OK Response
deactivate gateway

== Flow B: Route Utilization Report ==

client -> gateway : GET /api/flights/reports/route-utilization
activate gateway

gateway -> controller : Forward GET /api/flights/reports/route-utilization
activate controller

controller -> report_svc : getRouteUtilizationReport()
activate report_svc

report_svc -> repo : findAll()
activate repo

repo -> db : SELECT * FROM company_flights
activate db
db --> repo : List<Flight> entities
deactivate db

report_svc --> report_svc : Group by route and count flights
repo --> report_svc : RouteUtilizationReport data
deactivate repo

report_svc --> controller : Report DTO list
deactivate report_svc

controller --> gateway : 200 OK (RouteUtilizationReport JSON)
deactivate controller

gateway --> client : 200 OK Response
deactivate gateway

== Exception Handling Flow (Alternative Path) ==

note over controller, exception_handler : If invalid input or unhandled exception occurs
controller -[#red]> exception_handler : Throws Exception / DomainException
activate exception_handler
exception_handler --> client : 400 / 409 / 500 (ErrorDetails JSON)
deactivate exception_handler

@enduml
